APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./data/app.db

RTSP_CONNECT_TIMEOUT=10
RTSP_RECONNECT_MAX_DELAY=30
DEFAULT_RTSP_PORT=554

# --- Дополнительные настройки (можно оставить значения по умолчанию) ---

# Путь к ffmpeg.exe. Пусто = автоопределение:
#   1) <корень проекта>/bin/ffmpeg(.exe)
#   2) системный PATH
# Если путь указан, но не существует — приложение автоматически перейдёт к поиску.
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Ограничение FPS MJPEG-превью, отдаваемого в браузер (кадры берутся актуальные,
# старые отбрасываются — это ограничение только частоты отдачи, не чтения потока).
# PREVIEW_FPS=10

# Размер буфера кадров каждого потока: хранятся только самые свежие кадры
# (drop old, keep latest). Важно для будущего AI-этапа.
# FRAME_BUFFER_SIZE=2

# Секунды без кадров, после которых соединение считается зависшим
# и принудительно переподключается.
# FRAME_STALL_TIMEOUT=10

# --- AI (детекция людей, трекинг, распознавание лиц) ---
# AI_ENABLED=true          # false = только RTSP-превью, без AI
# AI_FPS=5                 # кадров/сек на камеру для AI (превью не ограничивается)
# AI_CAMERAS=              # "1,3,5" — пусто = все камеры
# AI_DEVICE=auto           # auto | cpu | cuda
# PERSON_CONFIDENCE=0.35   # порог YOLO для человека
# TRACK_LOST_TIMEOUT=3     # сек grace period трека (re-identification)
# MIN_RECOGNITION_CONFIDENCE=0.45  # порог сходства лица (алиас FACE_RECOGNITION_THRESHOLD)
# MIN_CONFIRMATIONS=2      # подряд совпавших распознаваний до подтверждения
# FACE_RECOGNITION_RETRY_INTERVAL=2  # сек между попытками распознать неизвестного
# PRESENCE_END_TIMEOUT=30  # сек без наблюдений → сессия присутствия закрывается
# FACE_MIN_SIZE=80         # мин. размер лица на фото сотрудника, px
# CUDA_DLL_PATH=           # путь к CUDA/cuDNN DLL (пусто = авто-поиск)

# --- Telegram-уведомления ---
# TELEGRAM_BOT_TOKEN=      # токен бота от @BotFather
# TELEGRAM_CHAT_ID=        # пусто = авто-определение (отправьте боту /start в группе)
# TELEGRAM_NOTIFY_UNKNOWN=true       # посторонний (с фото)
# TELEGRAM_NOTIFY_PRESENCE=true      # сотрудник пришёл / ушёл
# TELEGRAM_NOTIFY_GLOBAL_TRANSITION=true  # человек перешёл между камерами (с фото)
# TELEGRAM_NOTIFY_GLOBAL_NEW=false        # новый global_id (дублирует «посторонних»)

# --- Фиксация посторонних ---
# UNKNOWN_EVENT_COOLDOWN=60   # сек между фиксациями на одной камере
# UNKNOWN_KEEP_DAYS=30        # сколько дней хранить события

# --- Межкамерный трекинг (Multi-Camera Person Tracking) ---
# MULTI_CAMERA_TRACKING_ENABLED=true   # false = система работает как раньше
# REID_MODEL=models/osnet_x0_25_msmt17.onnx
# REID_EMBEDDING_INTERVAL=2.5   # сек между обновлениями эмбеддинга трека
# REID_SIMILARITY_THRESHOLD=0.80
# GLOBAL_MATCH_THRESHOLD=0.65   # composite score для связывания
# GLOBAL_MATCH_MARGIN=0.05      # отрыв от 2-го кандидата (иначе новый ID)
# GLOBAL_GALLERY_TTL=600        # сек жизни identity в памяти
# GLOBAL_HISTORY_LEN=20         # эмбеддингов в истории identity
# GLOBAL_KEEP_DAYS=30
# TOPOLOGY_CONFIG=topology.json # см. topology.json.example; пусто = без ограничений
# MC_DEBUG=false                # логи [REID]/[MATCH]/[IDENTITY]
# W_REID=0.55                   # веса composite score (reid+temporal+topology+aspect+face)
# W_TEMPORAL=0.15
# W_TOPOLOGY=0.15
# W_ASPECT=0.05
# W_FACE=0.10
